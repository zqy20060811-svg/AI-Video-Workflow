APP_NAME=AI Video Workflow
APP_ENV=development

# PostgreSQL (Docker 容器 ai-video-workflow-postgres，宿主机端口 5436)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5436/ai_video_workflow

REDIS_URL=redis://localhost:6379/0

# 相对 backend 运行目录，指向项目根目录下的 storage/
STORAGE_DIR=../storage

# LLM 配置（OpenAI 兼容 API：OpenAI / DeepSeek / Ollama 等）
# 示例（DeepSeek）：
#   LLM_API_KEY=sk-xxx
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 示例（本机 Ollama）：
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
