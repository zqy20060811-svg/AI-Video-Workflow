APP_NAME=AI Video Workflow
APP_ENV=development

# PostgreSQL (Docker 容器 ai-video-workflow-postgres，宿主机端口 5436)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5436/ai_video_workflow

REDIS_URL=redis://localhost:6379/0

# 相对 backend 运行目录，指向项目根目录下的 storage/
STORAGE_DIR=../storage

# LLM 配置（OpenAI 兼容 API：OpenAI / DeepSeek / Ollama 等）
# 示例（DeepSeek）：
#   LLM_API_KEY=sk-xxx
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 示例（本机 Ollama）：
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# ---------- 图片生成 ----------
# 可选值：none（未配置）/ comfyui
IMAGE_PROVIDER=none
# ComfyUI 中已安装的 checkpoint 文件名，例如 sd15.safetensors
IMAGE_MODEL=

# ---------- 视频生成（Image-to-Video）----------
# 可选值：none（未配置）/ comfyui
VIDEO_PROVIDER=none
# LTX-Video 等 I2V 模型的 unet / clip / vae 文件名（ComfyUI models 目录内）
VIDEO_MODEL=
VIDEO_CLIP_MODEL=
VIDEO_VAE_MODEL=
VIDEO_FPS=24

# ComfyUI 服务地址（图片/视频 Provider 共用）
COMFYUI_URL=http://127.0.0.1:8188
# 生成任务轮询间隔与超时（秒）
GEN_POLL_INTERVAL=2
GEN_TIMEOUT=600
